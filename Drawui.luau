                    local parent = drag.target._p.Parent
                    local delta = (mouse - drag.from) / (parent and parent._scale or 1)
                    drag.target.Position = UDim2.new(p.X.Scale, p.X.Offset + delta.X, p.Y.Scale, p.Y.Offset + delta.Y)
