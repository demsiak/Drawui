-- ==== Modifiers/Constraints.luau ====
;(function()
-- Modifiers/Constraints: UIScale, UIAspectRatioConstraint, UISizeConstraint, UITextSizeConstraint.
return function(UI, ctx)
    local U = ctx.U

    UI.RegisterClass("UIScale", {
        Base = "UIComponent",
        Defaults = { Scale = 1 },
        ScaleFactor = function(m) return m._p.Scale end,
    })

    UI.RegisterClass("UIAspectRatioConstraint", {
        Base = "UIConstraint", Order = 1,
        Defaults = { AspectRatio = 1, DominantAxis = "Width", AspectType = "FitWithinMaxSize" },
        AdjustSize = function(m, n, size)
            local ratio = m._p.AspectRatio
            if ratio <= 0 then return size end
            if U.enumName(m._p.DominantAxis) == "Height" then return Vector2.new(size.Y * ratio, size.Y) end
            return Vector2.new(size.X, size.X / ratio)
        end,
    })

    UI.RegisterClass("UISizeConstraint", {
        Base = "UIConstraint", Order = 2,
        Defaults = function(p) p.MinSize = U.ZERO; p.MaxSize = Vector2.new(math.huge, math.huge) end,
        AdjustSize = function(m, n, size)
            local p, s = m._p, n._scale
            return Vector2.new(U.clamp(size.X, p.MinSize.X * s, p.MaxSize.X * s), U.clamp(size.Y, p.MinSize.Y * s, p.MaxSize.Y * s))
        end,
    })

    -- Limits the size chosen by TextScaled.
    UI.RegisterClass("UITextSizeConstraint", {
        Base = "UIConstraint",
        Defaults = { MinTextSize = 1, MaxTextSize = 100 },
        TextSizeLimits = function(m, n)
            return m._p.MinTextSize * n._scale, m._p.MaxTextSize * n._scale
        end,
    })
end
end)()(UI, ctx)
-- ==== Modifiers/Layouts.luau ====
;(function()
-- Modifiers/Layouts: UIListLayout (with Wraps) and UIGridLayout.
-- An Arrange hook returns { [child] = { pos = Vector2, size = Vector2 } } and the content size.
return function(UI, ctx)
    local U = ctx.U
    local ZERO = U.ZERO

    UI.RegisterClass("UIListLayout", {
        Base = "UILayout",
        Defaults = function(p) p.Padding = UDim.new(0, 0); p.Wraps = false end,
        Coerce = { Padding = U.toUDim },
        Arrange = function(layout, n, children, inner, scale)
            local p = layout._p
            local horizontal = U.enumName(p.FillDirection) == "Horizontal"
            ctx.sortForLayout(layout, children)
            local mainLimit = horizontal and inner.X or inner.Y
            local gap = U.udim(p.Padding, mainLimit, scale)
            local lines, line = {}, { items = {}, main = 0, cross = 0 }
            for _, c in ipairs(children) do
                local s = ctx.nodeSize(c, inner, scale)
                local main, cross = horizontal and s.X or s.Y, horizontal and s.Y or s.X
                if p.Wraps and #line.items > 0 and line.main + gap + main > mainLimit then
                    table.insert(lines, line)
                    line = { items = {}, main = 0, cross = 0 }
                end
                if #line.items > 0 then line.main += gap end
                table.insert(line.items, { node = c, size = s, at = line.main })
                line.main += main
                line.cross = math.max(line.cross, cross)
            end
            if #line.items > 0 then table.insert(lines, line) end
            local totalMain, totalCross = 0, 0
            for i, l in ipairs(lines) do
                totalMain = math.max(totalMain, l.main)
                totalCross += l.cross + (i > 1 and gap or 0)
            end
            local content = horizontal and Vector2.new(totalMain, totalCross) or Vector2.new(totalCross, totalMain)
            local placements = {}
            local hA, vA = p.HorizontalAlignment, p.VerticalAlignment
            local crossAt = 0
            for _, l in ipairs(lines) do
                for _, item in ipairs(l.items) do
                    local s = item.size
                    local pos
                    if horizontal then
                        pos = Vector2.new(item.at + U.align(hA, inner.X - l.main),
                            U.align(vA, inner.Y - content.Y) + crossAt + U.align(vA, l.cross - s.Y))
                    else
                        pos = Vector2.new(U.align(hA, inner.X - content.X) + crossAt + U.align(hA, l.cross - s.X),
                            item.at + U.align(vA, inner.Y - l.main))
                    end
                    placements[item.node] = { pos = pos, size = s }
                end
                crossAt += l.cross + gap
            end
            return placements, content
        end,
    })

    UI.RegisterClass("UIGridLayout", {
        Base = "UILayout",
        Defaults = function(p)
            p.CellSize = UDim2.fromOffset(100, 40); p.CellPadding = UDim2.fromOffset(8, 8)
            p.FillDirection = "Horizontal"; p.FillDirectionMaxCells = 0
        end,
        Arrange = function(layout, n, children, inner, scale)
            local p = layout._p
            local horizontal = U.enumName(p.FillDirection) == "Horizontal"
            ctx.sortForLayout(layout, children)
            local cell = U.vec(p.CellSize, inner, scale)
            cell = Vector2.new(math.max(1, cell.X), math.max(1, cell.Y))
            local gap = U.vec(p.CellPadding, inner, scale)
            local count = p.FillDirectionMaxCells
            if count <= 0 then
                count = math.floor(((horizontal and inner.X or inner.Y) + (horizontal and gap.X or gap.Y))
                    / math.max(1, horizontal and cell.X + gap.X or cell.Y + gap.Y))
            end
            count = math.max(1, math.floor(count))
            local rows = math.ceil(#children / count)
            local used = math.min(count, #children)
            local content = ZERO
            if #children > 0 then
                content = horizontal and Vector2.new(used * (cell.X + gap.X) - gap.X, rows * (cell.Y + gap.Y) - gap.Y)
                    or Vector2.new(rows * (cell.X + gap.X) - gap.X, used * (cell.Y + gap.Y) - gap.Y)
            end
            local offset = Vector2.new(U.align(p.HorizontalAlignment, inner.X - content.X), U.align(p.VerticalAlignment, inner.Y - content.Y))
            local placements = {}
            for i, c in ipairs(children) do
                local a, b = (i - 1) % count, math.floor((i - 1) / count)
                ctx.nodeSize(c, inner, scale)
                placements[c] = { pos = (horizontal and Vector2.new(a * (cell.X + gap.X), b * (cell.Y + gap.Y))
                    or Vector2.new(b * (cell.X + gap.X), a * (cell.Y + gap.Y))) + offset, size = cell }
            end
            return placements, content
        end,
    })
end
end)()(UI, ctx)
-- ==== Builder/Builder.luau ====
;(function()
-- Builder/Builder: declarative construction on top of UI.new.
--
--   local New, Children, OnEvent, OnChange = UI.New, UI.Children, UI.OnEvent, UI.OnChange
--   local card = New "Frame" {
--       Size = UDim2.fromOffset(240, 120),
--       Corner = 10,                                  -- sugar: UICorner
--       Stroke = { Color = Color3.new(1, 1, 1), Transparency = 0.8 },
--       Gradient = { Color3.fromRGB(40, 44, 60), Color3.fromRGB(26, 28, 38) },
--       Shadow = true,
--       Padding = 12,
--       [Children] = {
--           Title = New "TextLabel" { Text = "Hello", Size = UDim2.new(1, 0, 0, 20) },  -- key = Name
--           New "TextButton" { Text = "Go", Activated = function() print("go") end },   -- event shorthand
--       },
--       [OnChange "AbsoluteSize"] = function(size) end,
--       [UI.Ref] = function(node) myCard = node end,
--   }
--
-- Sugar keys are pluggable: UI.RegisterSugar(name, function(node, value) ... end).
return function(UI, ctx)
    local U = ctx.U
    local Builder = {}
    UI.Builder = Builder

    local function marker(name) return setmetatable({}, { __tostring = function() return name end }) end
    local CHILDREN, REF = marker("UI.Children"), marker("UI.Ref")
    Builder.Children, Builder.Ref = CHILDREN, REF
    UI.Children, UI.Ref = CHILDREN, REF

    local eventKeys, changeKeys = {}, {}
    function Builder.OnEvent(name)
        if not eventKeys[name] then eventKeys[name] = { kind = "event", name = name } end
        return eventKeys[name]
    end
    function Builder.OnChange(property)
        if not changeKeys[property] then changeKeys[property] = { kind = "change", name = property } end
        return changeKeys[property]
    end
    UI.OnEvent, UI.OnChange = Builder.OnEvent, Builder.OnChange

    local sugar = {}
    function Builder.RegisterSugar(key, fn)
        assert(type(key) == "string" and type(fn) == "function", "RegisterSugar(name, function(node, value))")
        sugar[key] = fn
    end
    UI.RegisterSugar = Builder.RegisterSugar

    local function addChildren(node, list)
        if ctx.isLive(list) then list.Parent = node; return end
        assert(type(list) == "table", "[Children] expects an object or a list of objects")
        for _, c in ipairs(list) do addChildren(node, c) end
        local named = {}
        for key in pairs(list) do if type(key) == "string" then table.insert(named, key) end end
        table.sort(named)
        for _, key in ipairs(named) do
            local c = list[key]
            assert(ctx.isLive(c), "[Children]." .. key .. " must be a UI object")
            c.Name = key
            c.Parent = node
        end
    end

    local function apply(node, props)
        local parent
        local deferred = {}
        for key, value in pairs(props) do
            if key == "Parent" then parent = value
            elseif type(key) == "string" then
                if node._p[key] ~= nil then node[key] = value
                elseif ctx.eventNames[key] and type(value) == "function" then node[key]:Connect(value)
                elseif sugar[key] then table.insert(deferred, { sugar[key], value })
                else node[key] = value end -- raises "Unsupported property"
            elseif key == CHILDREN then table.insert(deferred, { addChildren, value })
            elseif key == REF then table.insert(deferred, { function(n, v)
                if type(v) == "function" then v(n) else v.value = n end
            end, value })
            elseif type(key) == "table" and key.kind == "event" then node[key.name]:Connect(value)
            elseif type(key) == "table" and key.kind == "change" then
                local name = key.name
                node:GetPropertyChangedSignal(name):Connect(function() value(node[name]) end)
            else error("Unsupported builder key: " .. tostring(key)) end
        end
        for _, d in ipairs(deferred) do d[1](node, d[2]) end
        if parent then node.Parent = parent end
    end

    -- New "Class" { props } -> object
    function Builder.New(class)
        return function(props)
            local node = UI.new(class)
            local ok, err = pcall(apply, node, props or {})
            if not ok then node:Destroy(); error(err, 2) end
            return node
        end
    end
    UI.New = Builder.New

    -- Hydrate "existing" { props }: apply builder props to an object that already exists.
    function Builder.Hydrate(node)
        assert(ctx.isLive(node), "Hydrate expects a live UI object")
        return function(props) apply(node, props or {}); return node end
    end
    UI.Hydrate = Builder.Hydrate

    -- Built-in sugar -------------------------------------------------------------------------------
    local function make(class, node, props)
        props.Parent = node
        return UI.new(class, props)
    end
    local function propsOr(value, primary)
        if typeof(value) == "table" and getmetatable(value) == nil and value[1] == nil then return table.clone(value) end
        return { [primary] = value }
    end

    Builder.RegisterSugar("Corner", function(node, v) make("UICorner", node, propsOr(v, "CornerRadius")) end)
    Builder.RegisterSugar("Stroke", function(node, v)
        if v == true then v = {} end
        local props
        if typeof(v) == "Color3" then props = { Color = v }
        elseif type(v) == "number" then props = { Thickness = v }
        else props = table.clone(v) end
        make("UIStroke", node, props)
    end)
    Builder.RegisterSugar("Gradient", function(node, v)
        local props
        if type(v) == "table" and getmetatable(v) == nil and (v.Color ~= nil or v.Rotation ~= nil or v.Transparency ~= nil or v.Offset ~= nil) then
            props = table.clone(v)
        else props = { Color = v } end
        make("UIGradient", node, props)
    end)
    -- Shadow = true uses a soft preset; a table is passed through (Blur is accepted for BlurRadius).
    Builder.RegisterSugar("Shadow", function(node, v)
        local props
        if v == true then
            props = { BlurRadius = 18, Offset = UDim2.fromOffset(0, 6), Transparency = 0.5 }
        else
            props = table.clone(v)
            if props.Blur ~= nil then props.BlurRadius = props.BlurRadius or props.Blur; props.Blur = nil end
        end
        make("UIShadow", node, props)
    end)
    Builder.RegisterSugar("Padding", function(node, v)
        local props = {}
        if type(v) == "number" or typeof(v) == "UDim" then
            for _, side in ipairs({ "Left", "Right", "Top", "Bottom" }) do props["Padding" .. side] = U.toUDim(v) end
        else
            for key, value in pairs(v) do
                if key == "Horizontal" then props.PaddingLeft = value; props.PaddingRight = value
                elseif key == "Vertical" then props.PaddingTop = value; props.PaddingBottom = value
                elseif string.sub(key, 1, 7) == "Padding" then props[key] = value
                else props["Padding" .. key] = value end
            end
        end
        make("UIPadding", node, props)
    end)
    Builder.RegisterSugar("Scale", function(node, v) make("UIScale", node, { Scale = v }) end)
    Builder.RegisterSugar("AspectRatio", function(node, v) make("UIAspectRatioConstraint", node, propsOr(v, "AspectRatio")) end)
    Builder.RegisterSugar("SizeLimit", function(node, v) make("UISizeConstraint", node, table.clone(v)) end)
    Builder.RegisterSugar("TextSizeLimit", function(node, v) make("UITextSizeConstraint", node, table.clone(v)) end)
    Builder.RegisterSugar("List", function(node, v) make("UIListLayout", node, v == true and {} or propsOr(v, "Padding")) end)
    Builder.RegisterSugar("Grid", function(node, v) make("UIGridLayout", node, v == true and {} or table.clone(v)) end)
end
end)()(UI, ctx)
return UI
