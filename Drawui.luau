-- ==== Classes/ScrollingFrame.luau ====
;(function()
-- Classes/ScrollingFrame: canvas sizing in PreChildren, scrollbar in DrawAfter.
-- Wheel and thumb dragging are handled in Input/Input.
return function(UI, ctx)
    local U = ctx.U
    local clamp = U.clamp
    UI.RegisterClass("ScrollingFrame", {
        Base = "GuiObject",
        ReadOnly = { AbsoluteCanvasSize = true },
        Defaults = function(p)
            p.CanvasSize = UDim2.new(); p.CanvasPosition = U.ZERO; p.AbsoluteCanvasSize = U.ZERO
            p.AutomaticCanvasSize = "Y"; p.ScrollingEnabled = true; p.ScrollingDirection = "Y"
            p.ScrollBarThickness = 5; p.ScrollBarImageColor3 = Color3.fromRGB(113, 125, 155)
            p.ScrollBarImageTransparency = 0.1; p.ClipsDescendants = true; p.Active = true
        end,
        Hittable = function() return true end,
        PreChildren = function(n, info)
            local p = n._p
            local explicit = U.vec(p.CanvasSize, info.size, info.scale)
            local pad = info.topLeft + info.bottomRight
            local canvas = Vector2.new(
                U.isAuto(p.AutomaticCanvasSize, "X") and math.max(explicit.X, info.content.X + pad.X) or explicit.X,
                U.isAuto(p.AutomaticCanvasSize, "Y") and math.max(explicit.Y, info.content.Y + pad.Y) or explicit.Y)
            ctx.changed(n, "AbsoluteCanvasSize", canvas)
            local cp, size = p.CanvasPosition, info.size
            ctx.changed(n, "CanvasPosition", Vector2.new(clamp(cp.X, 0, math.max(0, canvas.X - size.X)),
                clamp(cp.Y, 0, math.max(0, canvas.Y - size.Y))))
            info.origin -= p.CanvasPosition
        end,
        DrawAfter = function(n, style)
            local p = n._p
            local s = style.size
            if not ctx.nonempty(style.visible) or p.ScrollBarThickness <= 0 then return end
            local total = p.AbsoluteCanvasSize.Y
            if total <= s.Y or U.enumName(p.ScrollingDirection) == "X" then return end
            local thickness = p.ScrollBarThickness * n._scale
            local height = math.min(s.Y, math.max(18 * n._scale, s.Y * s.Y / total))
            local offset = p.CanvasPosition.Y / (total - s.Y) * (s.Y - height)
            local thumbPos, thumbSize = style.pos + Vector2.new(s.X - thickness - 2, offset), Vector2.new(thickness, height)
            ctx.fillRounded(n, thumbPos, thumbSize, thickness / 2, U.multiply(p.ScrollBarImageColor3, style.tint),
                style.opacity * (1 - p.ScrollBarImageTransparency), style.clip)
            table.insert(ctx.hits, { node = n, rect = ctx.intersect(ctx.rect(thumbPos, thumbSize), style.clip), scrollbar = true, height = height,
                transform = ctx.transform, screenClip = ctx.screenClip })
        end,
    })
end
end)()(UI, ctx)
-- ==== Modifiers/UICorner.luau ====
;(function()
-- Modifiers/UICorner: rounds the parent's background, border, strokes, gradient, image and hit area.
-- CornerRadius.Scale is relative to the parent's shorter side (0.5 = pill / circle).
-- Accepts a number as shorthand for UDim.new(0, number).
return function(UI, ctx)
    local U = ctx.U
    UI.RegisterClass("UICorner", {
        Base = "UIComponent",
        Defaults = function(p) p.CornerRadius = UDim.new(0, 8) end,
        Coerce = { CornerRadius = U.toUDim },
        Style = function(m, n, style)
            local s = style.size
            style.radius = math.max(0, U.udim(m._p.CornerRadius, math.min(s.X, s.Y), n._scale))
        end,
    })
end
end)()(UI, ctx)
-- ==== Modifiers/UIStroke.luau ====
;(function()
-- Modifiers/UIStroke: outline around the parent.
--   ApplyStrokeMode      "Contextual" (text objects: outline the text) | "Border" (always the box)
--   BorderStrokePosition "Outer" | "Center" | "Inner"
--   LineJoinMode         "Round" | "Miter" | "Bevel" (Round rounds outer corners of sharp boxes)
-- Drawn as a ring of Quads, so translucent strokes have no overlapping seams.
return function(UI, ctx)
    local U = ctx.U
    local function isContextualText(m, n)
        return n._class.IsText and U.enumName(m._p.ApplyStrokeMode) ~= "Border"
    end
    UI.RegisterClass("UIStroke", {
        Base = "UIComponent",
        Defaults = function(p)
            p.Color = Color3.fromRGB(75, 82, 103); p.Thickness = 1; p.Transparency = 0; p.Enabled = true
            p.ApplyStrokeMode = "Contextual"; p.BorderStrokePosition = "Outer"; p.LineJoinMode = "Round"
        end,
        Style = function(m, n, style)
            if isContextualText(m, n) then
                style.textStroke = { Color = U.multiply(m._p.Color, style.tint), Transparency = m._p.Transparency }
            end
        end,
        Overlay = function(m, n, style)
            if isContextualText(m, n) then return end
            local p = m._p
            local t = p.Thickness * n._scale
            if t <= 0 then return end
            local position = U.enumName(p.BorderStrokePosition)
            local d0, d1 = 0, t
            if position == "Center" then d0, d1 = -t / 2, t / 2
            elseif position == "Inner" then d0, d1 = -t, 0 end
            ctx.ring(n, style.pos, style.size, style.radius, d0, d1, U.multiply(p.Color, style.tint),
                style.opacity * (1 - p.Transparency), style.clip, U.enumName(p.LineJoinMode) == "Round")
        end,
    })
end
end)()(UI, ctx)
-- ==== Modifiers/UIGradient.luau ====
;(function()
-- Modifiers/UIGradient: multiplies the parent's background (and text / image tint) by a gradient.
--   Color        ColorSequence, Color3, {Color3, Color3, ...} or {{time, Color3}, ...}
--   Transparency NumberSequence, number or list (same forms as Color)
--   Rotation     degrees, any angle (the shape is sliced into bands along the direction)
--   Offset       Vector2 shift in scale units along the gradient direction
--   ApplyToText  (extension) false keeps text / image colours untinted; true matches Roblox
return function(UI, ctx)
    local U = ctx.U
    UI.RegisterClass("UIGradient", {
        Base = "UIComponent",
        Defaults = function(p)
            p.Color = U.WHITE; p.Transparency = 0; p.Rotation = 0; p.Offset = U.ZERO; p.Enabled = true
            p.ApplyToText = true
        end,
        Style = function(m, n, style)
            local p = m._p
            local colors, transparency = U.keypoints(p.Color), U.keypoints(p.Transparency)
            local angle = math.rad(p.Rotation)
            style.gradient = {
                Colors = colors, Transparency = transparency, Rotation = p.Rotation,
                Shift = p.Offset.X * math.cos(angle) + p.Offset.Y * math.sin(angle),
                Constant = U.constant(colors) and U.constant(transparency),
                ApplyToText = p.ApplyToText,
                Opaque = (function()
                    for _, k in ipairs(transparency) do if k.Value > 0.001 then return false end end
                    return true
                end)(),
            }
        end,
    })
end
end)()(UI, ctx)
-- ==== Modifiers/UIShadow.luau ====
;(function()
-- Modifiers/UIShadow: Roblox's UIShadow.
--   Color, Transparency, Enabled
--   BlurRadius        UDim (scale relative to the parent's shorter side); a number means pixels
--   Offset, Spread    UDim2 (relative to the parent's size); a Vector2 / number means pixels
--   Inset             true = inner shadow drawn inside the parent's shape
--   Mode              "Shape" (shadow of the box) or "Text" (drop shadow under the parent's text)
--   ShowBehindParent  false draws a Shape shadow over the parent's background
-- Blur is built from stacked translucent rounded rects whose combined opacity is 1 - Transparency.
-- Drawing text can't blur, so Text-mode shadows ignore BlurRadius.
return function(UI, ctx)
    local U = ctx.U

    local function toUDim2(v)
        if type(v) == "number" then return UDim2.fromOffset(v, v) end
        if typeof(v) == "Vector2" then return UDim2.fromOffset(v.X, v.Y) end
        return v
    end

    local function metrics(m, n, style)
        local p, s, scale = m._p, style.size, n._scale
        return math.max(0, U.udim(p.BlurRadius, math.min(s.X, s.Y), scale)), U.vec(p.Offset, s, scale), U.vec(p.Spread, s, scale)
    end
    local function layersFor(blur) return blur < 1 and 1 or U.clamp(math.ceil(blur / 2.5), 2, 10) end
    local function perLayer(total, layers) return 1 - (1 - math.min(total, 0.999)) ^ (1 / layers) end

    local function outer(m, n, style)
        local p = m._p
        local total = style.opacity * (1 - p.Transparency)
        if total <= 0 then return end
        local blur, offset, spread = metrics(m, n, style)
        local pos, size = style.pos + offset - spread, style.size + spread * 2
        if size.X <= 0 or size.Y <= 0 then return end
        local radius = style.radius > 0 and math.max(0, style.radius + math.max(spread.X, spread.Y)) or 0
        local color = U.multiply(p.Color, style.tint)
        local layers = layersFor(blur)
        local per = layers == 1 and total or perLayer(total, layers)
        -- Layers run from blur/2 inside the edge to blur/2 outside it, bunched towards the outside.
        for i = layers, 1, -1 do
            local f = layers == 1 and 0.5 or (i - 1) / (layers - 1)
            local grow = blur * (f * f - 0.5)
            local s = size + Vector2.new(grow * 2, grow * 2)
            if s.X > 0 and s.Y > 0 then
                ctx.fillRounded(n, pos - Vector2.new(grow, grow), s, math.max(0, radius + grow), color, per, style.clip)
            end
        end
    end

    local function inner(m, n, style)
        local p = m._p
        local total = style.opacity * (1 - p.Transparency)
        if total <= 0 then return end
        local blur, offset, spread = metrics(m, n, style)
        local clip = ctx.intersect(style.area, style.clip)
        if not ctx.nonempty(clip) then return end
        local far = math.max(style.size.X, style.size.Y) + math.abs(offset.X) + math.abs(offset.Y) + blur
        local color = U.multiply(p.Color, style.tint)
        local layers = layersFor(blur)
        local per = layers == 1 and total or perLayer(total, layers)
        local base = math.max(spread.X, spread.Y)
        -- Everything outside the shifted, shrunk inner box is in shadow; each layer shrinks further.
        for i = 1, layers do
            local f = layers == 1 and 0 or (i - 1) / (layers - 1)
            ctx.ring(n, style.pos + offset, style.size, style.radius, -(base + blur * f * f), far, color, per, clip, false)
        end
    end

    local function mode(m) return U.enumName(m._p.Mode) end

    UI.RegisterClass("UIShadow", {
        Base = "UIComponent",
        Defaults = function(p)
            p.Color = U.BLACK; p.Transparency = 0; p.Enabled = true
            p.BlurRadius = UDim.new(0, 0); p.Offset = UDim2.new(); p.Spread = UDim2.new()
            p.Inset = false; p.Mode = "Shape"; p.ShowBehindParent = true; p.ZIndex = -1
        end,
        Coerce = { BlurRadius = U.toUDim, Offset = toUDim2, Spread = toUDim2 },
        Style = function(m, n, style)
            if mode(m) ~= "Text" then return end
            local p = m._p
            style.textShadow = { Color = U.multiply(p.Color, style.tint), Opacity = 1 - p.Transparency,
                Offset = U.vec(p.Offset, style.size, n._scale) }
        end,
        Underlay = function(m, n, style)
            local p = m._p
            if mode(m) == "Shape" and not p.Inset and p.ShowBehindParent then outer(m, n, style) end
        end,
        Overlay = function(m, n, style)
            local p = m._p
            if mode(m) ~= "Shape" then return end
            if p.Inset then inner(m, n, style) elseif not p.ShowBehindParent then outer(m, n, style) end
        end,
    })
end
end)()(UI, ctx)
