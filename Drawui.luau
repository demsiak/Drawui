;(function()
-- Animation/Tween: TweenService-style tweens for number, Color3, Vector2, UDim and UDim2 properties.
return function(UI, ctx)
    local U = ctx.U
    local TweenService = game:GetService("TweenService")
    local tweens = {}
    ctx.tweens = tweens
    local tweenable = { number = true, Color3 = true, Vector2 = true, UDim2 = true, UDim = true }

    function UI.Tween(n, info, goal)
        assert(ctx.isLive(n), "Tween target must be a live UI object")
        info = info or TweenInfo.new(0.25)
        assert(info.RepeatCount == 0 and not info.Reverses, "RepeatCount/Reverses are not implemented")
        local t = { Completed = ctx.signal(), PlaybackState = Enum.PlaybackState.Begin, _from = {}, _elapsed = 0 }
        for key, value in pairs(goal) do
            assert(n._p[key] ~= nil and not ctx.readonly[key] and key ~= "Parent", "Invalid tween property: " .. key)
            assert(typeof(n._p[key]) == typeof(value), "Tween property types must match: " .. key)
            assert(tweenable[typeof(value)], "Unsupported tween value: " .. typeof(value))
        end
        function t:Play()
            if table.find(tweens, self) then return end
            assert(not n._dead, "Tween target was destroyed")
            for _, other in ipairs(table.clone(tweens)) do
                if other._target == n then
                    for key in pairs(goal) do if other._goal[key] ~= nil then other:Cancel(); break end end
                end
            end
            self._from = {}
            for key in pairs(goal) do self._from[key] = n._p[key] end
            self._elapsed = 0
            self.PlaybackState = Enum.PlaybackState.Playing
            self._target, self._goal, self._info = n, goal, info
            table.insert(tweens, self)
            ctx.start()
        end
        function t:Cancel()
            local i = table.find(tweens, self)
            if i then table.remove(tweens, i) end
            self.PlaybackState = Enum.PlaybackState.Cancelled
            self.Completed:Fire(self.PlaybackState)
        end
        t:Play()
        return t
    end
    function ctx.Methods:Tween(info, goal) return UI.Tween(self, info, goal) end

    local function lerp(from, to, alpha)
        if type(to) == "number" then return from + (to - from) * alpha end
        local kind = typeof(to)
        if kind == "UDim" then return UDim.new(from.Scale + (to.Scale - from.Scale) * alpha, from.Offset + (to.Offset - from.Offset) * alpha) end
        if kind == "Color3" then return U.mix(from, to, alpha) end
        return from:Lerp(to, alpha)
    end

    function ctx.stepTweens(dt)
        for _, t in ipairs(table.clone(tweens)) do
            if t._target._dead then t:Cancel()
            else
                t._elapsed += dt
                local info = t._info
                local raw = U.clamp((t._elapsed - info.DelayTime) / math.max(0.00001, info.Time), 0, 1)
                local alpha = TweenService:GetValue(raw, info.EasingStyle, info.EasingDirection)
                for key, to in pairs(t._goal) do t._target[key] = lerp(t._from[key], to, alpha) end
                if raw >= 1 then
                    local index = table.find(tweens, t)
                    if index then table.remove(tweens, index) end
                    t.PlaybackState = Enum.PlaybackState.Completed
                    t.Completed:Fire(t.PlaybackState)
                end
            end
        end
    end
    table.insert(ctx.shutdownHooks, function()
        for _, t in ipairs(table.clone(tweens)) do t:Cancel() end
    end)
end
end)()(UI, ctx)
-- ==== Classes/Base.luau ====
;(function()
-- Classes/Base: abstract hierarchy.
--   Instance
--   ├─ GuiBase (rendered, holds children)
--   │   ├─ ScreenGui
--   │   └─ GuiObject ── GuiButton
--   ├─ UIComponent (modifiers) ── UIConstraint, UILayout
return function(UI, ctx)
    local U = ctx.U

    UI.RegisterClass("Instance", { Abstract = true })

    UI.RegisterClass("GuiBase", {
        Base = "Instance", Abstract = true, Gui = true,
        Defaults = function(p)
            p.Visible = true; p.Active = false; p.Interactable = true
            p.Position = UDim2.new(); p.Size = UDim2.fromOffset(100, 100); p.AnchorPoint = U.ZERO
            p.BackgroundColor3 = Color3.fromRGB(30, 33, 43); p.BackgroundTransparency = 0
            p.BorderColor3 = Color3.fromRGB(64, 69, 85); p.BorderSizePixel = 0
            p.ZIndex = 1; p.LayoutOrder = 0; p.ClipsDescendants = false; p.AutomaticSize = "None"
            p.AbsolutePosition = U.ZERO; p.AbsoluteSize = U.ZERO
            p.Rotation = 0; p.AbsoluteRotation = 0
        end,
        Hittable = function(n) return n._p.Active end,
    })
    ctx.readonly.AbsoluteRotation = true

    UI.RegisterClass("GuiObject", { Base = "GuiBase", Abstract = true })

    UI.RegisterClass("GuiButton", {
        Base = "GuiObject", Abstract = true,
        Defaults = { AutoButtonColor = true, Active = true },
        Hittable = function() return true end,
        Style = function(n, style)
            local p = n._p
            if not (p.AutoButtonColor and p.Interactable) then return end
            if ctx.pressed == n then style.background = U.mix(style.background, U.BLACK, 0.22)
            elseif ctx.hovered == n then style.background = U.mix(style.background, U.WHITE, 0.10) end
        end,
    })

    UI.RegisterClass("UIComponent", { Base = "Instance", Abstract = true, Modifier = true })
    UI.RegisterClass("UIConstraint", { Base = "UIComponent", Abstract = true })
    UI.RegisterClass("UILayout", {
        Base = "UIComponent", Abstract = true,
        ReadOnly = { AbsoluteContentSize = true },
        Defaults = function(p)
            p.FillDirection = "Vertical"; p.SortOrder = "LayoutOrder"
            p.HorizontalAlignment = "Left"; p.VerticalAlignment = "Top"; p.AbsoluteContentSize = U.ZERO
        end,
    })

    -- Shared defaults for TextLabel / TextButton / TextBox.
    function ctx.textDefaults(p, text)
        p.Text = text; p.TextColor3 = U.WHITE
        p.TextSize = 16; p.Font = 0; p.TextTransparency = 0; p.TextBounds = U.ZERO
        p.TextXAlignment = "Center"; p.TextYAlignment = "Center"
        p.TextWrapped = false; p.TextScaled = false; p.LineHeight = 1.15
        p.TextStrokeTransparency = 1; p.TextStrokeColor3 = U.BLACK
    end
    ctx.readonly.TextBounds = true

    -- Shared defaults for ImageLabel / ImageButton.
    function ctx.imageDefaults(p)
        p.Image = ""; p.ImageColor3 = U.WHITE; p.ImageTransparency = 0
    end
    -- Image draw hook. Drawing has no UV/scissor API, so partially clipped images are hidden.
    function ctx.drawImage(n, style)
        local p = n._p
        if p.Image == "" or not ctx.fullyInside(style.area, style.clip) then return end
        local color, alpha = U.multiply(p.ImageColor3, style.tint), style.opacity * (1 - p.ImageTransparency)
        if style.gradient and style.gradient.ApplyToText then
            local c, a = ctx.gradientAt(style.gradient, 0.5)
            color, alpha = U.multiply(color, c), alpha * a
        end
        if alpha <= 0 then return end
        local at = style.pos
        if ctx.transform then
            -- Drawing Image can't rotate: draw it upright around the rotated centre.
            local half = style.size / 2
            local center = ctx.applyTransform(ctx.transform, style.pos + half)
            if not ctx.fullyInside(ctx.rect(center - half, style.size), ctx.screenClip) then return end
            at = center - half
        end
        ctx.primitive(n, "Image", { Data = p.Image, Position = at, Size = style.size, Rounding = style.radius,
            Color = color, Transparency = U.clamp(alpha, 0, 1) })
    end
end
end)()(UI, ctx)
