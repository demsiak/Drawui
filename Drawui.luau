        for _, p in ipairs(pts) do
            local last = out[#out]
            if not last or not (same(last.X, p.X) and same(last.Y, p.Y)) then table.insert(out, p) end
        end
        while #out > 1 and same(out[1].X, out[#out].X) and same(out[1].Y, out[#out].Y) do table.remove(out) end
