        if kind == "Color3" or kind == "number" then
            return { { Time = 0, Value = seq }, { Time = 1, Value = seq } }
        end
        assert(type(seq) == "table" and #seq > 0, "Expected a ColorSequence, NumberSequence, Color3, number or list")
